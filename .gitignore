# macOS metadata
._*
.DS_Store
.AppleDouble
.LSOverride

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/
*.egg

# Virtual Environments
venv/
ENV/
env/
.venv

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~
.claude/

# Database files (large binary files)
*.db
*.sqlite
*.sqlite3

# Large raw data files (keep processed outputs only)
Export-Data/*.csv
Export-Data/*.xlsx
Export-Data/*.xls
Export-Data/*.jsonl
Export-Data/*.jsonl.gz

# But keep the database and small reference files if needed
!Export-Data/exports.db
!Export-Data/data/*.csv
!output/**/*.csv

# Temporary files
*.tmp
*.log
.cache/
*.bak

# OS
.DS_Store
Thumbs.db

# Jupyter Notebook
.ipynb_checkpoints/
*.ipynb

# Environment variables
.env
.env.local

# Output files - keep only the final summaries
output/*_full.csv
output/*_clean.csv
output/by_fruit/
output/**/temp_*
output/**/*_draft*

# Sankey diagrams (regenerable)
Export-Data/sankey-*.png
Export-Data/sankey-*.svg
Export-Data/sankey-*.mmd
Export-Data/sankey-*.html

# Archive files
Export-Data/*.zip
